---
import { Image } from 'astro:assets';
import asifHead from '../assets/asif-head.png';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { CAL_URL, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getWriting } from '../series';

const { blocks } = await getWriting();
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="home">
			<section class="intro">
				<Image
					class="avatar"
					src={asifHead}
					alt={SITE_TITLE}
					width={112}
					height={112}
					densities={[1, 2]}
				/>
				<div>
					<h1>{SITE_TITLE}</h1>
					<p>{SITE_DESCRIPTION}</p>
					<p class="cta-line">
						<a href={CAL_URL} target="_blank" rel="noopener">Book 15 minutes with me</a> to
						talk tech or philosophy or leadership.
					</p>
				</div>
			</section>

			<div class="cols">
				<div class="col-writing">
					<h2>Writing</h2>
					{
						blocks.map((b) =>
							b.kind === 'series' ? (
								<div class="series-group">
									<span class="series-name">{b.group.name}</span>
									<p class="series-blurb">{b.group.blurb}</p>
									<ul>
										{b.group.parts.map((p, i) => (
											<li>
												<a href={`/blog/${p.id}/`}>
													<span class="post-title">
														<span class="pnum">{i + 1}.</span>
														{p.data.title}
													</span>
													<FormattedDate date={p.data.pubDate} />
												</a>
											</li>
										))}
									</ul>
								</div>
							) : (
								<ul>
									{b.posts.map((post) => {
										const isLink = Boolean(post.data.link);
										return (
											<li>
												<a
													href={isLink ? post.data.link : `/blog/${post.id}/`}
													{...(isLink ? { target: '_blank', rel: 'noopener' } : {})}
												>
													<span class="post-title">
														{post.data.title}
														{isLink && <span class="ext"> ↗</span>}
													</span>
													<FormattedDate date={post.data.pubDate} />
												</a>
											</li>
										);
									})}
								</ul>
							)
						)
					}
				</div>

				<aside class="col-making">
					<h2>Making</h2>
					<ul>
						<li>
							<a href="https://math.sifxtreme.com" target="_blank" rel="noopener">
								<span class="post-title">Printable math worksheets<span class="ext"> ↗</span></span>
							</a>
							<p class="post-desc">
								Free word problems, logic puzzles and arithmetic drills for 3rd–5th
								grade, plus step-through animations of long division and
								multiplication. Sized to five minutes rather than to fill a page. No
								signup, no ads.
							</p>
						</li>
						<li>
							<a href="https://typing.sifxtreme.com" target="_blank" rel="noopener">
								<span class="post-title">Type Quest<span class="ext"> ↗</span></span>
							</a>
							<p class="post-desc">
								A touch-typing tutor that shows the finger coming back to the home
								row, the one habit every other tutor hides. One page, no signup, no
								ads.
							</p>
						</li>
					</ul>
				</aside>
			</div>
		</main>
		<Footer />
	</body>

	<style>
		.home {
			width: 920px;
			max-width: calc(100% - 2em);
		}
		.intro {
			display: flex;
			align-items: center;
			gap: 1.4em;
			padding: 1em 0 2em;
			border-bottom: 1px solid rgb(var(--border));
		}
		.avatar {
			width: 96px;
			height: 96px;
			border-radius: 50%;
			object-fit: cover;
			object-position: center top;
			flex-shrink: 0;
			border: 3px solid rgb(var(--surface));
			box-shadow: var(--box-shadow);
		}
		.intro h1 {
			font-size: 2.2rem;
			margin-bottom: 0.2em;
		}
		.intro p {
			color: rgb(var(--gray));
			font-size: 1.15rem;
			margin: 0;
		}
		.intro .cta-line {
			margin-top: 0.6em;
			font-size: 0.95rem;
		}
		.intro .cta-line a {
			color: var(--accent);
			font-weight: 600;
		}
		@media (max-width: 520px) {
			.intro {
				flex-direction: column;
				align-items: flex-start;
				text-align: left;
			}
		}
		.cols {
			display: grid;
			grid-template-columns: 1fr 300px;
			gap: 3em;
			align-items: start;
			margin-top: 2.5em;
		}
		@media (max-width: 820px) {
			.cols {
				grid-template-columns: 1fr;
				gap: 2.5em;
			}
		}
		h2 {
			font-size: 0.85rem;
			text-transform: uppercase;
			letter-spacing: 0.12em;
			color: rgb(var(--gray));
			margin: 0 0 1.5em;
		}
		ul {
			list-style: none;
			margin: 0;
			padding: 0;
		}
		li {
			padding: 1.1em 0;
			border-bottom: 1px solid rgb(var(--border));
		}
		.col-writing li a,
		.col-making li a {
			display: flex;
			align-items: baseline;
			justify-content: space-between;
			gap: 1em;
			text-decoration: none;
		}
		.post-title {
			color: rgb(var(--black));
			font-weight: 700;
			font-size: 1.2rem;
			letter-spacing: -0.01em;
		}
		li a:hover .post-title {
			color: var(--accent);
		}
		.ext {
			color: var(--accent);
			font-size: 0.85em;
		}
		.col-writing li a :global(time),
		.col-making li a :global(time) {
			color: rgb(var(--gray));
			font-size: 0.85rem;
			white-space: nowrap;
			flex-shrink: 0;
		}
		.post-desc {
			color: rgb(var(--gray));
			margin: 0.4em 0 0;
			font-size: 0.95rem;
			line-height: 1.45;
		}
		.series-group {
			margin-bottom: 2em;
			padding: 1.2em 1.3em;
			border: 1px solid rgb(var(--border));
			border-radius: 14px;
			background: rgba(var(--gray), 0.05);
		}
		.series-name {
			font-size: 0.72rem;
			text-transform: uppercase;
			letter-spacing: 0.08em;
			color: rgb(var(--gray));
		}
		.series-blurb {
			margin: 0.4em 0 0.4em;
			color: rgb(var(--gray-dark));
			font-size: 0.98rem;
			line-height: 1.5;
		}
		.series-group ul li:last-child {
			border-bottom: 0;
			padding-bottom: 0.2em;
		}
		.pnum {
			display: inline-block;
			min-width: 1.5em;
			color: rgb(var(--gray));
			font-weight: 600;
		}
		h3.more {
			font-size: 0.85rem;
			text-transform: uppercase;
			letter-spacing: 0.12em;
			color: rgb(var(--gray));
			margin: 2.5em 0 0.5em;
		}
		.col-making {
			position: sticky;
			top: 2em;
		}
	</style>
</html>
