---
import { SITE_TITLE, CAL_URL } from '../consts';
const today = new Date();
---

<footer>
	<span class="book">
		<a href={CAL_URL} target="_blank" rel="noopener">Book 15 minutes with me</a> to talk
		tech or philosophy or leadership.
	</span>
	<span>&copy; {today.getFullYear()} {SITE_TITLE}</span>
	<span class="built"><a href="/how-these-are-written/">Every post says how AI was used.</a></span>
</footer>
<style>
	footer {
		padding: 2.5em 1em 4em;
		border-top: 1px solid rgb(var(--border));
		color: rgb(var(--gray));
		font-size: 0.85rem;
		text-align: center;
		display: flex;
		flex-direction: column;
		gap: 0.4em;
	}
	.book a {
		color: var(--accent);
		font-weight: 600;
	}
	.built {
		opacity: 0.75;
	}
	.built a {
		color: inherit;
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	/* ---- receipt design (DESIGN in consts.ts): printed onto the mat ---- */
	:global(html[data-design='receipt']) footer {
		color: var(--mat-ink);
		border-top: 1px dashed rgba(255, 255, 255, 0.18);
		font-family: var(--mono);
	}
	:global(html[data-design='receipt']) .book a {
		color: #fde047;
	}

	/* ---- transit design (DESIGN in consts.ts): end of the line ---- */
	:global(html[data-design='transit']) footer {
		border-top: 2px dashed var(--zone-rule);
		color: var(--muted);
		font-family: var(--mono);
	}
	:global(html[data-design='transit']) .book a {
		color: var(--br-ink);
	}
</style>
