---
// Transit design — post layout. A post is a station: a platform sign for the title, the
// previous/next stop on the same line, the article, and a departures board for the build
// telemetry. Same props and the same parts as the classic and receipt layouts.
import { Image } from 'astro:assets';
import { getCollection, type CollectionEntry } from 'astro:content';
import AIBadge from '../../components/AIBadge.astro';
import BaseHead from '../../components/BaseHead.astro';
import CopyForLLM from '../../components/CopyForLLM.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import PangramBadge from '../../components/PangramBadge.astro';
import SeriesNav from '../../components/SeriesNav.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import TelemetryFooter from '../../components/TelemetryFooter.astro';

type Props = CollectionEntry<'blog'>['data'] & {
	ogImagePath?: string;
	slug?: string;
	body?: string;
};

const {
	title,
	description,
	problem,
	pubDate,
	updatedDate,
	heroImage,
	aiUsage,
	tags,
	link,
	telemetry,
	pangram,
	series,
	ogImagePath,
	slug,
	body,
} = Astro.props;
const linkHost = link ? new URL(link).hostname.replace(/^www\./, '') : null;
const canonicalUrl = slug ? new URL(`/blog/${slug}/`, Astro.site).href : undefined;

const LINES = {
	handwritten: { name: 'Handwritten Line', b: 'H' },
	dictated: { name: 'Handwritten Line', b: 'D' },
	assisted: { name: 'Assisted Line', b: 'A' },
	'ai-written': { name: 'AI-Written Line', b: 'AI' },
	series: { name: 'Series Branch', b: 'S' },
} as const;
const lineKey = series ? 'series' : aiUsage;
const line = LINES[lineKey];

// Previous / next stop: the neighbouring posts on this post's own line (or its series).
let prev: CollectionEntry<'blog'> | undefined;
let next: CollectionEntry<'blog'> | undefined;
if (slug) {
	const all = await getCollection('blog');
	const sameLine = all
		.filter((p) => (series ? p.data.series?.name === series.name : !p.data.series && p.data.aiUsage === aiUsage))
		.sort((a, b) =>
			series
				? a.data.series!.part - b.data.series!.part
				: a.data.pubDate.valueOf() - b.data.pubDate.valueOf() || a.id.localeCompare(b.id),
		);
	const at = sameLine.findIndex((p) => p.id === slug);
	prev = at > 0 ? sameLine[at - 1] : undefined;
	next = at >= 0 ? sameLine[at + 1] : undefined;
}
const stopHref = (p: CollectionEntry<'blog'>) => `/blog/${p.id}/`;
const longDate = pubDate.toLocaleDateString('en-US', {
	weekday: 'long',
	month: 'long',
	day: 'numeric',
	year: 'numeric',
	timeZone: 'UTC',
});
const cars = pangram
	? Array.from({ length: 10 }, (_, i) => Math.max(0, Math.min(1, pangram.human / 10 - i)))
	: [];
const hasAside = Boolean(telemetry || pangram);
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} ogImagePath={ogImagePath} />
	</head>

	<body>
		<Header />
		<main class="t-post" data-line={lineKey}>
			<div class="sign">
				<div class="big" aria-hidden="true">{line.b}</div>
				<div>
					<div class="sub">{line.name} · {longDate}</div>
					<h1>{title}</h1>
				</div>
			</div>
			{
				(prev || next) && (
					<nav class="strip" aria-label="Neighbouring posts on this line">
						{prev ? (
							<a class="prev" href={stopHref(prev)}>
								<small>← Previous stop</small>
								{prev.data.title}
							</a>
						) : (
							<span class="prev">
								<small>← Previous stop</small>Terminus
							</span>
						)}
						<svg class="rail" viewBox="0 0 180 22" aria-hidden="true">
							<line x1="4" y1="11" x2="176" y2="11" stroke-width="6" stroke-linecap="round" />
							<circle class="stop" cx="22" cy="11" r="6" stroke-width="4" />
							<circle class="stop" cx="158" cy="11" r="6" stroke-width="4" />
							<circle class="here" cx="90" cy="11" r="9" stroke-width="4" />
						</svg>
						{next ? (
							<a class="next" href={stopHref(next)}>
								<small>Next stop →</small>
								{next.data.title}
							</a>
						) : (
							<span class="next">
								<small>Next stop →</small>Terminus
							</span>
						)}
					</nav>
				)
			}

			<div class:list={['stationgrid', { solo: !hasAside }]}>
				<div class="main-col">
					{description && <p class="dek">{description}</p>}
					<div class="byline">
						<FormattedDate date={pubDate} />
						<AIBadge usage={aiUsage} />
						<PangramBadge pangram={pangram} />
						{
							updatedDate && (
								<span class="last-updated-on">
									Updated <FormattedDate date={updatedDate} />
								</span>
							)
						}
					</div>
					{
						link && (
							<a class="source-link" href={link} target="_blank" rel="noopener">
								↗ Read the original on {linkHost}
							</a>
						)
					}
					{
						body && canonicalUrl && (
							<div class="copy-slot">
								<CopyForLLM title={title} description={description} url={canonicalUrl} body={body} />
							</div>
						)
					}
					<div class="rule" aria-hidden="true"></div>
					{
						heroImage && (
							<div class="hero-image">
								<Image width={1020} height={510} src={heroImage} alt="" />
							</div>
						)
					}
					{
						problem && (
							<aside class="problem">
								<span class="problem__label">The problem</span>
								<p class="problem__text">{problem}</p>
							</aside>
						)
					}
					<article class="prose">
						{series && slug && <SeriesNav name={series.name} part={series.part} currentSlug={slug} variant="top" />}
						<slot />
						{series && slug && <SeriesNav name={series.name} part={series.part} currentSlug={slug} variant="bottom" />}
					</article>
					{canonicalUrl && <ShareButtons title={title} url={canonicalUrl} />}
					{telemetry && <TelemetryFooter telemetry={telemetry} aiUsage={aiUsage} />}
					{
						tags && tags.length > 0 && (
							<div class="tags">
								{tags.map((t) => (
									<span class="tag">{t}</span>
								))}
							</div>
						)
					}
				</div>

				{
					hasAside && (
						<div class="aside">
							{telemetry && (
								<div class="board" role="table" aria-label="How this post was made">
									<div class="hd">
										<span>DEPARTURES</span>
										<b>{telemetry.model}</b>
									</div>
									<table>
										<tr>
											<th>JOURNEY</th>
											<th class="r">NO.</th>
											<th class="r">STATUS</th>
										</tr>
										<tr>
											<td>Turns</td>
											<td class="v">{telemetry.turns}</td>
											<td class="st">ARRIVED</td>
										</tr>
										<tr>
											<td>Tool calls</td>
											<td class="v">{telemetry.toolCalls}</td>
											<td class="st">ON TIME</td>
										</tr>
										<tr>
											<td>Live after</td>
											<td class="v">{telemetry.liveAfterMin}m</td>
											<td class="st">ON TIME</td>
										</tr>
										<tr>
											<td>Redeploys</td>
											<td class="v">{telemetry.redeploys}</td>
											<td class:list={['st', { amber: telemetry.redeploys > 0 }]}>
												{telemetry.redeploys > 0 ? 'RE-ROUTED' : 'NO CHANGES'}
											</td>
										</tr>
										<tr>
											<td>Compacts</td>
											<td class="v">{telemetry.compacts}</td>
											<td class="st">{telemetry.compacts > 0 ? 'DELAYED' : 'NO DELAYS'}</td>
										</tr>
									</table>
									{pangram && (
										<div class="tick">
											<span>
												Pangram verdict: {pangram.verdict} · {pangram.human}% human · {pangram.ai}% AI · please mind the gap
												between drafts
											</span>
										</div>
									)}
								</div>
							)}
							{pangram && (
								<div class="crew">
									<h3>Who drove this train</h3>
									<p>
										Pangram reads it as <b>{pangram.verdict}</b>. Each car is 10% of the text.
									</p>
									<div class="train" aria-hidden="true">
										{cars.map((f) => (
											<div class="carwrap">
												<div class="car">
													<i style={`width:${f * 100}%`} />
												</div>
												<div class="wheels">
													<b />
													<b />
												</div>
											</div>
										))}
									</div>
									<div class="split">
										<span class="h">{pangram.human}% human</span>
										<span class="a">{pangram.ai}% AI</span>
									</div>
								</div>
							)}
						</div>
					)
				}
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	main.t-post {
		--line: var(--as);
		background: none;
		border: 0;
		padding: 0;
		width: 1100px;
		max-width: calc(100% - 32px);
		margin: 3.5em auto 4em;
	}
	main.t-post::before {
		display: none;
	}
	main.t-post[data-line='handwritten'],
	main.t-post[data-line='dictated'] { --line: var(--hw); }
	main.t-post[data-line='ai-written'] { --line: var(--ai); }
	main.t-post[data-line='series'] { --line: var(--br); }

	.sign {
		background: var(--sign);
		color: var(--sign-ink);
		border-radius: 12px;
		padding: 22px 26px 20px;
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 20px;
		align-items: center;
		box-shadow: 0 6px 0 #000;
		position: relative;
	}
	.sign::before,
	.sign::after {
		content: '';
		position: absolute;
		top: -16px;
		width: 6px;
		height: 16px;
		background: #6b6e76;
		border-radius: 2px 2px 0 0;
	}
	.sign::before { left: 18%; }
	.sign::after { right: 18%; }
	.big {
		width: 64px;
		height: 64px;
		border-radius: 50%;
		display: grid;
		place-items: center;
		font: 900 28px var(--sans);
		color: #fff;
		border: 4px solid var(--sign-ink);
		background: var(--line);
	}
	.sign h1 {
		margin: 0;
		font: 800 clamp(28px, 4.4vw, 46px) / 1.08 var(--sans);
		letter-spacing: -0.02em;
		color: var(--sign-ink);
	}
	.sub {
		font: 600 13px var(--mono);
		letter-spacing: 0.14em;
		text-transform: uppercase;
		opacity: 0.72;
		margin-bottom: 6px;
	}
	.strip {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		gap: 10px;
		align-items: center;
		margin: 18px 4px 0;
		font-size: 15px;
		line-height: 1.35;
	}
	.strip a,
	.strip span {
		text-decoration: none;
		color: rgb(var(--gray-dark));
	}
	.strip a:hover {
		text-decoration: underline;
	}
	.strip .next {
		text-align: right;
	}
	.strip small {
		display: block;
		font: 700 11px var(--mono);
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--muted);
	}
	.rail {
		width: 180px;
		height: 22px;
	}
	.rail line {
		stroke: var(--line);
	}
	.rail .stop {
		fill: var(--paper);
		stroke: var(--line);
	}
	.rail .here {
		fill: var(--ink);
		stroke: #fde047;
	}

	.stationgrid {
		display: grid;
		grid-template-columns: minmax(0, 700px) 330px;
		gap: 48px;
		margin-top: 36px;
		justify-content: center;
		align-items: start;
	}
	.stationgrid.solo {
		grid-template-columns: minmax(0, 720px);
	}
	.dek {
		font: 400 22px/1.5 var(--serif);
		color: rgb(var(--gray-dark));
		margin: 0 0 16px;
	}
	.byline {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 14px;
		align-items: center;
		font: 600 14px var(--mono);
		color: var(--muted);
	}
	.last-updated-on {
		font-style: italic;
	}
	.source-link {
		display: inline-block;
		margin-top: 12px;
		font: 700 15px var(--mono);
		color: var(--as);
	}
	.copy-slot {
		margin-top: 12px;
	}
	.rule {
		height: 6px;
		background: var(--line);
		border-radius: 3px;
		margin: 26px 0 30px;
		position: relative;
	}
	.rule::after {
		content: '';
		position: absolute;
		left: 50%;
		top: -6px;
		width: 18px;
		height: 18px;
		margin-left: -9px;
		border-radius: 50%;
		background: var(--paper);
		border: 4px solid var(--line);
		box-sizing: border-box;
	}
	.hero-image img {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 10px;
		margin: 0 0 1.5em;
	}
	.problem {
		margin: 0 0 1.8em;
		padding: 0.9em 1.1em;
		background: var(--panel);
		border: 2px solid var(--ink);
		border-left: 8px solid var(--line);
		border-radius: 8px;
	}
	.problem__label {
		display: block;
		font: 800 11px var(--mono);
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--muted);
		margin-bottom: 0.3em;
	}
	.problem__text {
		margin: 0;
		font: 400 1.1rem/1.5 var(--serif);
		color: var(--ink);
	}
	.prose {
		font: 400 19px/1.7 var(--serif);
		color: rgb(var(--gray-dark));
	}
	.prose :global(p) {
		margin: 0 0 1.1em;
	}
	.prose :global(h2),
	.prose :global(h3) {
		font-family: var(--sans);
		color: var(--ink);
		display: flex;
		gap: 12px;
		align-items: center;
		line-height: 1.2;
	}
	.prose :global(h2) {
		font-size: 27px;
		font-weight: 800;
		margin: 1.6em 0 0.6em;
	}
	.prose :global(h3) {
		font-size: 21px;
		font-weight: 800;
		margin: 1.4em 0 0.5em;
	}
	.prose :global(h2)::before,
	.prose :global(h3)::before {
		content: '';
		flex: none;
		width: 16px;
		height: 16px;
		border-radius: 50%;
		border: 4px solid var(--line);
		background: var(--paper);
		box-sizing: border-box;
	}
	.prose :global(h3)::before {
		width: 12px;
		height: 12px;
		border-width: 3px;
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5em;
		margin-top: 1.5em;
	}
	.tag {
		font: 700 12px var(--mono);
		color: var(--ink);
		border: 2px solid var(--ink);
		border-radius: 999px;
		padding: 0.15em 0.8em;
		background: var(--panel);
	}

	.aside {
		position: sticky;
		top: 80px;
		display: grid;
		gap: 18px;
		min-width: 0;
	}
	.board {
		background: #0c0d0f;
		color: var(--amber);
		border-radius: 10px;
		padding: 14px 16px 12px;
		box-shadow: inset 0 0 0 3px #2a2b30, 0 6px 0 #000;
		font-family: var(--dot);
		min-width: 0;
	}
	.board .hd {
		display: flex;
		justify-content: space-between;
		gap: 10px;
		font-size: 15px;
		color: #fff;
		letter-spacing: 0.08em;
		border-bottom: 1px solid #333;
		padding-bottom: 8px;
		margin-bottom: 6px;
	}
	.board .hd b {
		color: var(--amber);
		font-weight: 400;
		overflow-wrap: anywhere;
		text-align: right;
	}
	.board table {
		width: 100%;
		border-collapse: collapse;
		font-size: 17px;
	}
	.board th {
		text-align: left;
		font-weight: 400;
		font-size: 12px;
		color: #8b8d93;
		letter-spacing: 0.1em;
		padding: 4px 0;
	}
	.board th.r {
		text-align: right;
	}
	.board td {
		padding: 6px 0;
		border-top: 1px dotted #2d2e33;
	}
	.board td.v {
		text-align: right;
		font-size: 22px;
	}
	.board td.st {
		text-align: right;
		color: #7ee39a;
		font-size: 13px;
		padding-left: 8px;
	}
	.board td.st.amber {
		color: var(--amber);
	}
	.board .tick {
		margin-top: 8px;
		overflow: hidden;
		white-space: nowrap;
		color: #fff;
		font-size: 14px;
		border-top: 1px solid #333;
		padding-top: 8px;
	}
	.board .tick span {
		display: inline-block;
		padding-left: 100%;
		animation: tick 16s linear infinite;
	}
	@keyframes tick {
		to {
			transform: translateX(-100%);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.board .tick span {
			animation: none;
			padding-left: 0;
			white-space: normal;
		}
	}
	.crew {
		background: var(--panel);
		border: 2px solid var(--ink);
		border-radius: 10px;
		padding: 16px 16px 14px;
	}
	.crew h3 {
		margin: 0 0 4px;
		font: 800 14px var(--mono);
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--ink);
	}
	.crew p {
		margin: 0 0 10px;
		font-size: 15px;
		color: rgb(var(--gray-dark));
	}
	.train {
		display: flex;
		gap: 3px;
		align-items: flex-end;
	}
	.carwrap {
		flex: 1;
	}
	.car {
		height: 30px;
		border-radius: 5px 5px 3px 3px;
		position: relative;
		overflow: hidden;
		border: 2px solid var(--ink);
		background: var(--ai);
	}
	.carwrap:first-child .car {
		border-radius: 14px 5px 3px 3px;
	}
	.car i {
		position: absolute;
		left: 0;
		top: 0;
		bottom: 0;
		background: var(--hw);
	}
	.car::after {
		content: '';
		position: absolute;
		left: 3px;
		right: 3px;
		top: 5px;
		height: 7px;
		background: rgba(255, 255, 255, 0.55);
		border-radius: 2px;
	}
	.wheels {
		display: flex;
		justify-content: space-around;
		height: 8px;
		margin-top: 2px;
	}
	.wheels b {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--ink);
	}
	.split {
		display: flex;
		justify-content: space-between;
		font: 700 14px var(--mono);
		margin-top: 8px;
	}
	.split .h { color: var(--hw); }
	.split .a { color: var(--ai); }

	@media (max-width: 1000px) {
		.stationgrid {
			grid-template-columns: minmax(0, 1fr);
		}
		.aside {
			position: static;
		}
	}
	@media (max-width: 700px) {
		main.t-post {
			margin-top: 2.5em;
		}
		.sign {
			padding: 18px 16px;
			gap: 14px;
		}
		.big {
			width: 48px;
			height: 48px;
			font-size: 20px;
			border-width: 3px;
		}
		.strip {
			grid-template-columns: 1fr 1fr;
		}
		.rail {
			display: none;
		}
		.prose {
			font-size: 18px;
		}
		.dek {
			font-size: 20px;
		}
	}
</style>
