---
// Receipt design — homepage. The writing list is printed as a receipt: one line item
// per post, colour-coded by how it was made, with its authoring turns as the "price".
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import asifHead from '../../assets/asif-head.png';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { CAL_URL, SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { getWriting, type Post } from '../../series';

const { blocks } = await getWriting();
const all = await getCollection('blog');

const CODE = { handwritten: 'HW', dictated: 'DI', assisted: 'AS', 'ai-written': 'AI' } as const;
const USAGES = [
	{ key: 'handwritten', label: 'written by hand' },
	{ key: 'dictated', label: 'dictated' },
	{ key: 'assisted', label: 'written with AI' },
	{ key: 'ai-written', label: 'written by AI' },
] as const;
const counts = USAGES.map((u) => ({ ...u, n: all.filter((p) => p.data.aiUsage === u.key).length })).filter(
	(u) => u.n > 0,
);
const totalTurns = all.reduce((sum, p) => sum + (p.data.telemetry?.turns ?? 0), 0);

const href = (p: Post) => p.data.link ?? `/blog/${p.id}/`;
const ext = (p: Post) => (p.data.link ? { target: '_blank', rel: 'noopener' } : {});
const turns = (p: Post) => (p.data.telemetry ? `${p.data.telemetry.turns}t` : '—');

const MAKING = [
	{
		title: 'Printable math worksheets',
		href: 'https://math.sifxtreme.com',
		desc: 'Free word problems, logic puzzles and arithmetic drills for 3rd–5th grade, plus step-through animations of long division and multiplication. Sized to five minutes rather than to fill a page. No signup, no ads.',
	},
	{
		title: 'Type Quest',
		href: 'https://typing.sifxtreme.com',
		desc: 'A touch-typing tutor that shows the finger coming back to the home row, the one habit every other tutor hides. One page, no signup, no ads.',
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="r-home">
			<div class="stack">
				<div class="copy pink" aria-hidden="true"></div>
				<div class="copy yellow" aria-hidden="true"></div>
				<section class="receipt">
					<span class="r-tape" aria-hidden="true"></span>
					<div class="c">
						<Image
							class="avatar"
							src={asifHead}
							alt={SITE_TITLE}
							width={84}
							height={84}
							densities={[1, 2]}
						/>
					</div>
					<h1 class="c name">{SITE_TITLE.toUpperCase()}<span>.</span></h1>
					<div class="c sub">sifxtreme.com · est. 2026</div>
					<hr class="r-dash" />
					<p class="tagline">{SITE_DESCRIPTION}</p>
					<a class="book" href={CAL_URL} target="_blank" rel="noopener">&gt; Book 15 minutes with me</a>
					<span class="book-rest">to talk tech or philosophy or leadership.</span>
					<hr class="r-dash" />

					<div class="line head sub"><span>item</span><span>turns</span></div>
					{
						blocks.map((b) =>
							b.kind === 'series' ? (
								<div class="series">
									<div class="series-head">
										<span>{b.group.name}</span>
										<span>{b.group.parts.length} pc</span>
									</div>
									<p class="series-blurb">{b.group.blurb}</p>
									{b.group.parts.map((p) => (
										<a class="line item" data-usage={p.data.aiUsage} href={href(p)} {...ext(p)}>
											<span class="t">
												<span class="r-code" data-usage={p.data.aiUsage}>{CODE[p.data.aiUsage]}</span>
												<mark>{p.data.title}</mark>
												{p.data.link && <span class="ext">↗</span>}
											</span>
											<span class="dots" />
											<span class="n">{turns(p)}</span>
										</a>
									))}
								</div>
							) : (
								b.posts.map((p) => (
									<a class="line item" data-usage={p.data.aiUsage} href={href(p)} {...ext(p)}>
										<span class="t">
											<span class="r-code" data-usage={p.data.aiUsage}>{CODE[p.data.aiUsage]}</span>
											<mark>{p.data.title}</mark>
											{p.data.link && <span class="ext">↗</span>}
										</span>
										<span class="dots" />
										<span class="n">{turns(p)}</span>
									</a>
								))
							)
						)
					}

					<hr class="r-dash" />
					<div class="split" aria-hidden="true">
						{counts.map((u) => <i data-usage={u.key} style={`flex:${u.n}`} />)}
					</div>
					{
						counts.map((u) => (
							<div class="line tot">
								<span>
									<span class="r-code" data-usage={u.key}>{CODE[u.key]}</span>
									{u.label}
								</span>
								<span>{u.n}</span>
							</div>
						))
					}
					<hr class="r-dash" />
					<div class="line grand"><span>TOTAL TURNS</span><span>{totalTurns.toLocaleString('en-US')}</span></div>
					<div class="barcode" aria-hidden="true"></div>
					<div class="c sub">no returns · every post shows its receipt</div>
					<div class="stamps" aria-hidden="true">
						<span class="stamp a">SHIPPED</span><span class="stamp b">NO ADS</span>
					</div>
				</section>
			</div>

			<aside class="making">
				<span class="r-tape pink" aria-hidden="true"></span>
				<h2>Making</h2>
				{
					MAKING.map((m) => (
						<div class="make">
							<a href={m.href} target="_blank" rel="noopener">
								{m.title} <span class="ext">↗</span>
							</a>
							<p>{m.desc}</p>
						</div>
					))
				}
				<hr class="r-dash" />
				<p class="legend">
					Every post says how it was made — <b>by hand</b>, <b>with AI</b>, or <b>by AI</b> — and prints
					what it took to make.
					<a href="/how-these-are-written">How these are written →</a>
				</p>
			</aside>
		</main>
		<Footer />
	</body>
</html>

<style>
	main.r-home {
		background: none;
		box-shadow: none;
		padding: 0;
		width: 900px;
		max-width: calc(100% - 2em);
		margin: 3.5em auto 2em;
		display: flex;
		gap: 56px;
		align-items: flex-start;
		justify-content: center;
	}
	.stack,
	.making {
		box-sizing: border-box;
	}
	.stack {
		position: relative;
		flex: 0 1 470px;
		min-width: 0;
	}
	.copy {
		position: absolute;
		inset: 0;
		border-radius: 2px;
	}
	.copy.pink {
		background: var(--carbon-pink);
		transform: rotate(2.4deg) translate(12px, 8px);
	}
	.copy.yellow {
		background: var(--carbon-yellow);
		transform: rotate(1.1deg) translate(6px, 4px);
	}
	.receipt {
		position: relative;
		background: var(--paper);
		padding: 34px 30px 40px;
		font: 13px/1.55 var(--mono);
		color: rgb(var(--gray-dark));
		box-shadow: var(--sheet-shadow);
		transform: rotate(-0.5deg);
	}
	.receipt::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: -12px;
		height: 12px;
		background:
			linear-gradient(-45deg, transparent 8px, var(--paper) 0) 0 0 / 16px 16px,
			linear-gradient(45deg, transparent 8px, var(--paper) 0) 0 0 / 16px 16px;
	}
	.receipt > .r-tape {
		top: -12px;
		left: 50%;
		margin-left: -55px;
		transform: rotate(-3deg);
	}
	.c {
		text-align: center;
	}
	.avatar {
		width: 84px;
		height: 84px;
		border-radius: 50%;
		object-fit: cover;
		object-position: center top;
		border: 3px solid var(--accent);
		padding: 3px;
		background: var(--paper);
	}
	.name {
		font: 800 26px/1.1 var(--mono);
		letter-spacing: -0.02em;
		margin: 12px 0 2px;
		color: rgb(var(--black));
	}
	.name span {
		color: var(--accent);
	}
	.sub {
		color: rgb(var(--gray));
		font-size: 11px;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}
	.tagline {
		margin: 0 0 10px;
		font-size: 13px;
		line-height: 1.55;
	}
	.book {
		display: inline-block;
		background: var(--accent);
		color: #fff;
		font-weight: 600;
		padding: 5px 10px;
		border-radius: 3px;
		text-decoration: none;
	}
	.book:hover {
		color: #fff;
		filter: brightness(1.08);
	}
	.book-rest {
		display: block;
		margin-top: 6px;
		color: rgb(var(--gray));
		font-size: 12px;
	}
	.line {
		display: flex;
		gap: 8px;
		align-items: baseline;
		justify-content: space-between;
	}
	.line.head {
		margin-bottom: 4px;
	}
	.item {
		padding: 5px 4px;
		margin: 0 -4px;
		border-radius: 3px;
		color: rgb(var(--gray-dark));
		text-decoration: none;
	}
	.item:hover {
		background: rgba(var(--accent-rgb), 0.1);
		color: rgb(var(--black));
	}
	.item .t {
		flex: 0 1 auto;
	}
	.item .r-code {
		margin-right: 6px;
	}
	.item mark {
		background: none;
		color: inherit;
	}
	/* hand-written posts get a highlighter pass */
	.item[data-usage='handwritten'] mark {
		background: linear-gradient(100deg, transparent 0 2%, var(--hi-yellow) 3% 97%, transparent 98%);
		padding: 0 2px;
	}
	.item .dots {
		flex: 1;
		border-bottom: 1.5px dotted var(--dots);
		transform: translateY(-4px);
		min-width: 20px;
	}
	.item .n {
		white-space: nowrap;
		color: rgb(var(--gray));
	}
	.ext {
		color: var(--accent);
	}
	.series {
		margin: 12px 0 8px;
		border-left: 3px solid var(--accent);
		padding-left: 8px;
		margin-left: -4px;
	}
	.series-head {
		display: flex;
		justify-content: space-between;
		background: var(--accent);
		color: #fff;
		padding: 3px 8px;
		margin-left: -11px;
		font-weight: 600;
		font-size: 11.5px;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		border-radius: 0 3px 3px 0;
	}
	.series-blurb {
		margin: 6px 0 4px;
		font-size: 12px;
		line-height: 1.5;
		color: rgb(var(--gray));
	}
	.split {
		display: flex;
		height: 12px;
		border-radius: 6px;
		overflow: hidden;
		margin: 4px 0 12px;
	}
	.split i[data-usage='handwritten'] { background: var(--hw); }
	.split i[data-usage='dictated'] { background: var(--di); }
	.split i[data-usage='assisted'] { background: var(--as); }
	.split i[data-usage='ai-written'] { background: var(--ai); }
	.tot {
		font-weight: 600;
		color: rgb(var(--black));
	}
	.tot .r-code {
		margin-right: 6px;
	}
	.grand {
		font-size: 17px;
		font-weight: 800;
		color: rgb(var(--black));
	}
	.barcode {
		height: 44px;
		margin: 18px auto 6px;
		width: 80%;
		background: repeating-linear-gradient(
			90deg,
			rgb(var(--black)) 0 2px,
			transparent 2px 4px,
			rgb(var(--black)) 4px 5px,
			transparent 5px 9px,
			rgb(var(--black)) 9px 12px,
			transparent 12px 14px
		);
	}
	.stamps {
		display: flex;
		justify-content: center;
		gap: 18px;
		margin-top: 18px;
	}
	.stamp {
		border: 3px solid;
		font-weight: 800;
		padding: 4px 10px;
		letter-spacing: 0.1em;
		opacity: 0.85;
		border-radius: 4px;
	}
	.stamp.a {
		color: var(--accent);
		transform: rotate(-8deg);
	}
	.stamp.b {
		color: var(--as);
		transform: rotate(6deg);
	}

	/* the "Making" ticket */
	.making {
		position: relative;
		flex: 0 0 290px;
		background: var(--stub);
		padding: 26px 22px 22px;
		box-shadow: var(--sheet-shadow);
		transform: rotate(1.8deg);
		margin-top: 40px;
		color: rgb(var(--gray-dark));
	}
	.making > .r-tape {
		top: -12px;
		left: 50%;
		width: 84px;
		margin-left: -42px;
		transform: rotate(-4deg);
	}
	.making h2 {
		font: 800 13px var(--mono);
		letter-spacing: 0.14em;
		text-transform: uppercase;
		margin: 0 0 12px;
		color: rgb(var(--black));
	}
	.make {
		margin-bottom: 16px;
	}
	.make a {
		font: 700 16px/1.3 var(--mono);
		color: rgb(var(--black));
		text-decoration: none;
	}
	.make a:hover {
		color: var(--accent);
	}
	.make p,
	.legend {
		margin: 6px 0 0;
		font-size: 14px;
		line-height: 1.5;
	}
	.making .r-dash {
		border-color: var(--stub-rule);
	}
	.legend a {
		display: inline-block;
		margin-top: 6px;
		font-weight: 600;
	}

	@media (max-width: 820px) {
		main.r-home {
			flex-direction: column;
			align-items: center;
			gap: 40px;
		}
		.stack {
			flex: none;
			width: 100%;
			max-width: 470px;
		}
		.copy {
			display: none;
		}
		.making {
			flex: none;
			width: 100%;
			max-width: 470px;
			margin-top: 0;
			transform: none;
		}
	}
	@media (max-width: 480px) {
		.receipt {
			padding: 30px 18px 36px;
			transform: none;
		}
	}
</style>
