---
// The post layout for whichever design is active (DESIGN in consts.ts).
// Each design's Post takes the same props, so this is a straight pass-through.
import type { CollectionEntry } from 'astro:content';
import { DESIGN } from '../consts';
import ClassicPost from '../designs/classic/Post.astro';
import ReceiptPost from '../designs/receipt/Post.astro';

type Props = CollectionEntry<'blog'>['data'] & {
	ogImagePath?: string;
	slug?: string;
	body?: string;
};

const Post = DESIGN === 'receipt' ? ReceiptPost : ClassicPost;
---

<Post {...Astro.props}><slot /></Post>
